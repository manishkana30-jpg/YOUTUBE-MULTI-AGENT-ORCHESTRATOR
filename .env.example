# ==============================================================================
# ANTIGRAVITY YOUTUBE MULTI-AGENT ORCHESTRATOR ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API (via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key
# JSON string or path with client_id, client_secret, refresh_token
YOUTUBE_OAUTH_CLIENT={"client_id":"","client_secret":"","refresh_token":""}

# SerpApi (Trending topic scraping: Hacker News, Product Hunt, Tech blogs)
SERPAPI_KEY=your_serpapi_key

# Sentry Error Reporting (Optional)
SENTRY_DSN=

# Server & Automation Worker
NODE_ENV=development
PORT=3001
CRON_SCHEDULE=0 9 * * *
ENABLE_MOCK_FALLBACK=true
