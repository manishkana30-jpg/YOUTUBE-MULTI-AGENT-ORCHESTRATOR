# ==============================================================================
# ANTIGRAVITY YOUTUBE MULTI-AGENT ORCHESTRATOR ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Required for AI generation)
# Get a free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL (Required for cloud database sync)
# Create a free database at: https://supabase.com/dashboard
# Copy from: Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional

# ------------------------------------------------------------------------------
# 3. YOUTUBE DATA API v3 (Required for uploading to your YouTube Channel)
# Step A: Get Client ID & Secret at: https://console.cloud.google.com/apis/credentials
# Step B: Run in terminal: npm run auth:youtube (it fills refresh_token automatically!)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT={"client_id":"","client_secret":"","refresh_token":""}

# ------------------------------------------------------------------------------
# 4. SERPAPI (Optional for live Hacker News, Product Hunt & tech blog scraping)
# Get a free key at: https://serpapi.com/manage-api-key
# ------------------------------------------------------------------------------
SERPAPI_KEY=

# ------------------------------------------------------------------------------
# 5. SENTRY ERROR REPORTING (Optional)
# Get a DSN at: https://sentry.io
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 6. SERVER & AUTOMATION WORKER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
CRON_SCHEDULE=0 9 * * *
ENABLE_MOCK_FALLBACK=true
