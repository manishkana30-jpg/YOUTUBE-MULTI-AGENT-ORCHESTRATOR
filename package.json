{
  "name": "youtube-auto-orchestrator",
  "version": "1.0.0",
  "description": "YouTube Multi-Agent Orchestrator powered by Gemini, Supabase, and Node-CRON",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test:pipeline": "tsx src/test-run.ts",
    "auth:youtube": "tsx scripts/auth-youtube.ts"
  },
  "keywords": [
    "youtube",
    "multi-agent",
    "orchestrator",
    "gemini",
    "supabase",
    "mcp",
    "cron"
  ],
  "author": "manishkana30-jpg",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@sentry/node": "^8.47.0",
    "@supabase/supabase-js": "^2.48.0",
    "@vercel/functions": "^3.9.9",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
